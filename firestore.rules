rules_version = '2';
// Sound School. Leaders and the church domain must match LEADERS / CHURCH_DOMAIN in index.html and storage.rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function leader() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in ['nick@rochesterchristian.church', 'nchlshodge@gmail.com'];
    }
    // Each person's profile and progress. They can save their own; leaders can read everyone's.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || leader());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'progressJson', 'xp', 'levels', 'lastSeen'])
        && request.resource.data.progressJson.size() < 200000;
      allow delete: if leader();
    }
    // Approvals for people without a church account. Leaders approve; someone a leader pre-approved by email
    // (invites/{email}) may create their own approval the first time they sign in.
    match /approvals/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || leader());
      allow write: if leader();
      allow create: if signedIn() && request.auth.uid == uid && request.auth.token.email_verified == true
        && request.resource.data.approved == true
        && get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.approved == true;
    }
    // Trainer sign-off after someone shadows a real service. Leaders write it; each person can read their own.
    match /signoffs/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || leader());
      allow write: if leader();
    }
    // The approved list leaders keep on the Team page, by email address (lowercase).
    match /invites/{email} {
      allow read: if leader() || (signedIn() && request.auth.token.email == email);
      allow write: if leader();
    }
  }
}
