rules_version = '2';
// Song stems are licensed: only signed-in church accounts, leaders and approved people can play them.
service firebase.storage {
  match /b/{bucket}/o {
    match /stems/{path=**} {
      allow read: if request.auth != null && request.auth.token.email_verified == true && (
        request.auth.token.email.matches('.*@rochesterchristian[.]church$')
        || request.auth.token.email in ['nick@rochesterchristian.church', 'nchlshodge@gmail.com']
        || firestore.get(/databases/(default)/documents/approvals/$(request.auth.uid)).data.approved == true);
      allow write: if false;
    }
    // Leaders upload the church's own songs here (compressed in the browser): audio only, up to 80 MB a file.
    match /stems/custom/{song}/{file} {
      allow write: if request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in ['nick@rochesterchristian.church', 'nchlshodge@gmail.com']
        && (request.resource == null || (request.resource.size < 80 * 1024 * 1024 && request.resource.contentType.matches('audio/.*')));
    }
  }
}
